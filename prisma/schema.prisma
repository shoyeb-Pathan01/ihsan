generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id                String   @id @default(cuid())
  name              String   @default("Mr. Khan")
  mission_start     String   @default("2026-08-23")
  mission_end       String   @default("2027-01-01")
  theme             String   @default("dark")
  baseline_azure    Int?     // 1-5
  baseline_arabic   Int?     // 1-5
  baseline_comm     Int?     // 1-5
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  goals             Goal[]
  daily_tasks       DailyTask[]
  reading_logs      QuranReading[]
  memorization_logs QuranMemorization[]
  tahajjud_logs     TahajjudLog[]
  communication_logs CommunicationSession[]
}

model Goal {
  id          String   @id @default(cuid())
  profile_id  String
  name        String
  category    String   // "azure" | "arabic"
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  profile     Profile  @relation(fields: [profile_id], references: [id])
  modules     GoalModule[]
  topics      GoalTopic[]
}

model GoalModule {
  id         String   @id @default(cuid())
  goal_id    String
  name       String
  description String?
  order_index Int    @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  goal       Goal     @relation(fields: [goal_id], references: [id])
  topics     GoalTopic[]
}

model GoalTopic {
  id                    String   @id @default(cuid())
  goal_id               String
  module_id             String?
  name                  String
  description           String?
  priority              String   @default("important") // "critical" | "important" | "supporting" | "bonus"
  status                String   @default("not_started") // "not_started" | "learning" | "practiced" | "revised" | "mastered"
  completion_percentage Float    @default(0)
  mastery_percentage    Float    @default(0)
  confidence            Int      @default(0) // 1-5
  notes                 String?
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  goal                  Goal     @relation(fields: [goal_id], references: [id])
  module                GoalModule? @relation(fields: [module_id], references: [id])
  progress_history      TopicProgress[]

  @@index([goal_id])
  @@index([module_id])
  @@index([status])
}

model TopicProgress {
  id                 String   @id @default(cuid())
  topic_id           String
  date               String   // YYYY-MM-DD
  status             String
  completion_delta   Float    @default(0)
  mastery_delta      Float    @default(0)
  notes              String?
  created_at         DateTime @default(now())

  topic              GoalTopic @relation(fields: [topic_id], references: [id])

  @@index([topic_id])
  @@unique([topic_id, date])
}

model AzureSession {
  id             String   @id @default(cuid())
  session_number Int
  title          String
  drive_link     String
  status         String   @default("not_started") // "not_started" | "completed"
  completed_at   DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@unique([session_number])
}

model AzurePractical {
  id              String   @id @default(cuid())
  practical_number Int
  title           String
  description     String?
  tasks           String   @default("[]") // JSON array of task strings
  status          String   @default("not_started") // "not_started" | "in_progress" | "completed"
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([practical_number])
}

model LisanLecture {
  id                    String   @id @default(cuid())
  lecture_number        Int
  title                 String
  youtube_url           String?
  duration_seconds      Int?
  status                String   @default("not_started") // "not_started" | "learning" | "completed"
  // Content pipeline
  watched               Boolean  @default(false)
  book                  Boolean  @default(false)
  lecture_notes         Boolean  @default(false) // renamed from 'notes' to avoid conflict
  quranic_examples      Boolean  @default(false)
  // Practice
  practice_status       String   @default("not_started") // "not_started" | "in_progress" | "completed"
  practice_notes_ok     Boolean  @default(false)
  practice_examples_ok  Boolean  @default(false)
  practice_exercises_ok Boolean  @default(false)
  practice_explain_ok   Boolean  @default(false)
  // Revision
  revision_count        Int      @default(0)
  last_revision_date    String?  // YYYY-MM-DD
  next_revision_date    String?  // YYYY-MM-DD
  // Mastery
  completion_percentage Float    @default(0)
  mastery_percentage    Float    @default(0)
  quiz_score            Int?     // 0-100
  understanding         Int?     // 1-5
  confidence            Int?     // 1-5
  // Tracking
  started_at            DateTime?
  completed_at          DateTime?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  practices             ArabicPractice[]
  revisions             ArabicRevision[]
  notes                 ArabicNote[]
  examples              ArabicExample[]
  explain_sessions      ArabicExplainIt[]

  @@unique([lecture_number])
  @@index([status])
  @@index([next_revision_date])
}

model ArabicPractice {
  id              String   @id @default(cuid())
  lecture_id      String
  exercise_number Int
  title           String
  description     String?
  exercise_type   String   @default("identify") // "identify" | "classify" | "explain" | "recall" | "apply" | "analyze"
  status          String   @default("not_started") // "not_started" | "in_progress" | "completed"
  user_answer     String?
  completed_at    DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  lecture         LisanLecture @relation(fields: [lecture_id], references: [id])
}

model ArabicRevision {
  id                String   @id @default(cuid())
  lecture_id        String
  date              String   // YYYY-MM-DD
  understanding     Int      // 1-5
  confidence        Int      // 1-5
  struggles         String?
  next_revision_date String? // YYYY-MM-DD
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  lecture           LisanLecture @relation(fields: [lecture_id], references: [id])
}

model ArabicNote {
  id                String   @id @default(cuid())
  lecture_id        String?
  topic             String?  // e.g. "Ism", "Fi'l", "Harf"
  arabic_term       String?
  meaning           String?
  examples          String?  // JSON array of examples
  my_understanding  String?
  category          String?  // "term" | "grammar" | "quranic" | "general"
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  lecture           LisanLecture? @relation(fields: [lecture_id], references: [id])
}

model ArabicExample {
  id                String   @id @default(cuid())
  lecture_id        String
  arabic_text       String
  translation       String?
  my_analysis       String?
  term_identified   String?  // e.g. "Ism", "Fi'l", "Harf"
  meaning           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  lecture           LisanLecture @relation(fields: [lecture_id], references: [id])
}

model ArabicExplainIt {
  id                String   @id @default(cuid())
  lecture_id        String
  prompt            String   // e.g. "Explain what Ism is without looking at notes"
  understanding     Int?     // 1-5
  confidence        Int?     // 1-5
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  lecture           LisanLecture @relation(fields: [lecture_id], references: [id])
}

model DailyTask {
  id          String   @id @default(cuid())
  profile_id  String
  date        String   // YYYY-MM-DD
  title       String
  category    String   // "azure" | "arabic" | "reading" | "memorization" | "tahajjud" | "communication"
  completed   Boolean  @default(false)
  is_must_do  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  profile     Profile  @relation(fields: [profile_id], references: [id])

  @@index([profile_id, date])
}

model DailyPlan {
  id          String   @id @default(cuid())
  profile_id  String
  date        String   // YYYY-MM-DD
  focus_item  String?  // description of what to focus on
  focus_type  String?  // "azure" | "arabic" | "reading" | "memorization" | "tahajjud" | "communication"
  focus_id    String?  // ID of linked item
  is_custom   Boolean  @default(true)
  completed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([profile_id, date])
}

model QuranReading {
  id               String   @id @default(cuid())
  profile_id       String
  date             String   // YYYY-MM-DD
  surah            String
  ayah_from        Int?
  ayah_to          Int?
  pages            Int      @default(1)
  duration_minutes Int?
  reflection       String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  profile          Profile  @relation(fields: [profile_id], references: [id])

  @@index([profile_id, date])
}

model QuranMemorization {
  id            String   @id @default(cuid())
  profile_id    String
  date          String   // YYYY-MM-DD
  surah         String
  ayah_from     Int
  ayah_to       Int
  is_new        Boolean  @default(true)
  confidence    Int      // 1-5
  mistakes      Int      @default(0)
  notes         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  profile       Profile  @relation(fields: [profile_id], references: [id])

  @@index([profile_id, date])
}

model TahajjudLog {
  id            String   @id @default(cuid())
  profile_id    String
  date          String   // YYYY-MM-DD
  completed     Boolean  @default(false)
  rakah_count   Int?
  time          String?  // approximate time
  reflection    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  profile       Profile  @relation(fields: [profile_id], references: [id])

  @@unique([profile_id, date])
}

model CommunicationSession {
  id               String   @id @default(cuid())
  profile_id       String
  date             String   // YYYY-MM-DD
  practice_type    String   // "Speaking" | "Reading Aloud" | "Technical Explanation" | etc
  duration_minutes Int?
  topic            String?
  confidence_score Int?     // 1-5
  clarity_score    Int?     // 1-5
  fluency_score    Int?     // 1-5
  notes            String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  profile          Profile  @relation(fields: [profile_id], references: [id])

  @@index([profile_id, date])
}

model Project {
  id              String   @id @default(cuid())
  name            String
  objective       String?
  status          String   @default("not_started") // "not_started" | "in_progress" | "completed"
  completion_pct  Float    @default(0)
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tasks           ProjectTask[]
}

model ProjectTask {
  id          String   @id @default(cuid())
  project_id  String
  title       String
  completed   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  project     Project  @relation(fields: [project_id], references: [id])
}

model Reminder {
  id              String   @id @default(cuid())
  text            String
  source_type     String   // "Quran" | "Hadith"
  reference       String
  category        String   // "dua" | "hadith"
  enabled         Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model Note {
  id          String   @id @default(cuid())
  content     String
  category    String?  // "azure" | "arabic" | "general"
  topic_id    String?
  lecture_id  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
